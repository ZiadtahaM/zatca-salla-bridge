# Database configuration (PostgreSQL 16+)
DATABASE_URL=postgres://zatca_admin:secret_zatca_password@127.0.0.1:5432/zatca_ledger

# Server configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Cryptographic Master Key for AES-256-GCM Vault (min 32 bytes or 64-character hex)
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
VAULT_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Security & Session Signing Secrets (min 32 bytes)
SESSION_SECRET=dev_zatca_session_signing_secret_32bytes_min

# Salla Partners App Credentials
SALLA_CLIENT_ID=your_salla_client_id
SALLA_CLIENT_SECRET=your_salla_client_secret
SALLA_WEBHOOK_SECRET=your_salla_webhook_secret

# ZATCA Gateway Environment (sandbox | simulation | production)
ZATCA_ENV=sandbox

# Support & Notifications
SUPPORT_WHATSAPP_NUMBER=966500000000
